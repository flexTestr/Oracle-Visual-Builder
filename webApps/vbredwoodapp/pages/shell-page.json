{
  "description": "",
  "routerFlow": "welcome",
  "variables": {
    "currentSelection": {
      "type": "any"
    },
    "messagesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "page:messageType"
      }
    },
    "navigationList": {
      "type": "navigationType[]",
      "defaultValue": [
        {
          "id": "welcome",
          "icon": "oj-ux-ico-home",
          "label": "Welcome"
        },
        {
          "id": "search",
          "icon": "oj-ux-ico-content-item-search",
          "label": "Search"
        },
        {
          "id": "dashboard",
          "icon": "oj-ux-ico-dashboard",
          "label": "Dashboard"
        },
        {
          "id": "guidedprocess",
          "icon": "oj-ux-ico-employee",
          "label": "Hire Employee"
        }
      ]
    },
    "navigationListADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $variables.navigationList }}",
        "itemType": "navigationType",
        "keyAttributes": "id"
      }
    }
  },
  "metadata": {},
  "types": {
    "messageType": {
      "id": "string",
      "severity": "string",
      "category": "string",
      "summary": "string",
      "detail": "string",
      "timestamp": "string",
      "autoTimeout": "number"
    },
    "navigationType": {
      "icon": "string",
      "id": "string",
      "label": "string"
    }
  },
  "eventListeners": {
    "vbNotification": {
      "chains": [
        {
          "chainId": "showNotification",
          "parameters": {
            "eventPayload": "{{ { id: $event.key, summary: $event.summary, detail: $event.message, severity: $event.type, autoTimeout: $event.displayMode === 'transient' ? 0 : -1 } }}"
          }
        }
      ]
    },
    "onMessageClose": {
      "chains": [
        {
          "chainId": "closeNotificationHandler",
          "parameters": {
            "eventMessage": "{{ $event.detail.message }}"
          }
        }
      ]
    },
    "inAppNavigationSpSelectionAction": {
      "chains": [
        {
          "chainId": "navigationHandler",
          "parameters": {
            "item": "[[ $event.detail.currentId ]]",
            "updatedFrom": "[[ $event.detail.updatedFrom ]]"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-messages": {
        "path": "ojs/ojmessages"
      },
      "oj-sp-in-app-navigation": {
        "path": "oj-sp/in-app-navigation/loader"
      },
      "oj-sp-pillar-theme": {
        "path": "oj-sp/pillar-theme/loader"
      }
    }
  },
  "translations": {}
}