{
  "title": "",
  "description": "",
  "variables": {
    "employeesListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_Employees",
        "keyAttributes": "id",
        "itemsPath": "items",
        "responseType": "getallEmployeesResponse",
        "uriParameters": {
          "orderBy": "rating:desc"
        },
        "filterCriterion": {
          "op": "$or",
          "criteria": [
            {
              "op": "$co",
              "attribute": "firstName",
              "value": "{{ $variables.searchVariable }}"
            },
            {
              "op": "$co",
              "attribute": "lastName",
              "value": "{{ $variables.searchVariable }}"
            },
            {
              "op": "$co",
              "attribute": "email",
              "value": "{{ $variables.searchVariable }}"
            }
          ]
        }
      }
    },
    "searchVariable": {
      "type": "string"
    }
  },
  "metadata": {},
  "types": {
    "@decorators.getallEmployeesResponse": {
      "endpoint": "getall_Employees",
      "service": "businessObjects",
      "path": "response"
    },
    "getallEmployeesResponse": {
      "items": [
        {
          "email": "string",
          "employeeId": "number",
          "firstName": "string",
          "hireDate": "string",
          "id": "number",
          "image": "string",
          "lastName": "string",
          "phoneNumber": "string",
          "rating": "number",
          "salary": "number"
        }
      ]
    }
  },
  "eventListeners": {},
  "imports": {
    "components": {
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-list-item-layout": {
        "path": "ojs/ojlistitemlayout"
      },
      "oj-list-view": {
        "path": "ojs/ojlistview"
      },
      "oj-sp-object-card": {
        "path": "oj-sp/object-card/loader"
      },
      "oj-sp-welcome-page": {
        "path": "oj-sp/welcome-page/loader"
      }
    }
  }
}
